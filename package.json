{
  "name": "lg-prompthon-figma-i18n-aidlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Figma UX 시나리오 기반 문맥 인식 i18n 자동화 + FE 코드 생성 (AI DLC)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "pipeline": "tsx src/pipeline/figma-i18n-pipeline.ts",
    "validate:i18n": "tsx scripts/validate-i18n.ts",
    "glossary:audit": "tsx scripts/glossary-audit.ts",
    "glossary:index": "tsx scripts/glossary-index.ts",
    "memory:index": "tsx scripts/memory-index.ts",
    "memory:search": "tsx scripts/memory-search.ts",
    "init:vectra": "tsx scripts/init-vectra.ts",
    "bench:embed": "tsx scripts/bench/embed-bench.ts",
    "reindex": "npm run glossary:index && npm run memory:index",
    "bench:threshold": "tsx scripts/bench/threshold.ts",
    "retriever:demo": "tsx scripts/retriever-demo.ts",
    "round:check": "tsx scripts/round-check.ts",
    "glossary:approve": "tsx scripts/glossary-approve.ts",
    "report:evolution": "tsx scripts/report-evolution.ts",
    "round:simulate": "tsx scripts/round-simulate.ts",
    "stats": "tsx scripts/stats.ts",
    "validate:layer3": "tsx scripts/validate-layer3.ts",
    "validate:layer3:selftest": "tsx scripts/layer3-selftest.ts",
    "retranslate": "tsx scripts/retranslate.ts"
  },
  "dependencies": {
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "14.1.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@testing-library/react": "14.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "17.4.2",
    "jsdom": "24.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vectra": "0.15.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
